{
  "type": "expect_error",
  "description": "POST /v1/crypto/decrypt: dir protected header but encrypted_key is non-empty — violates RFC 7516 §5.2 → 400 bad_request",
  "endpoint": "/v1/crypto/decrypt",
  "setup_key": {"kty": "oct", "alg": "A256GCM"},
  "protected_json": {"alg": "dir", "enc": "A256GCM", "kid": "$KID"},
  "body": {
    "protected":     "$PROTECTED",
    "encrypted_key": "dGVzdA",
    "iv":            "AAAAAAAAAAAAAAAA",
    "ciphertext":    "AAAA",
    "tag":           "AAAAAAAAAAAAAAAAAAAAAA"
  },
  "expected_status": 400,
  "expected_error": "bad_request"
}
